<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/custom_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#102238">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMART ORGANIZER"
        android:textColor="#82EAFF"
        android:textStyle="bold"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/custom_widget_label_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#82EAFF"
        android:textSize="11sp" />
    <Chronometer
        android:id="@+id/custom_widget_value_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="25sp" />
    <TextView
        android:id="@+id/custom_widget_label_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#82EAFF"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/custom_widget_value_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/custom_widget_label_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#82EAFF"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/custom_widget_value_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
</LinearLayout>
